# Required runtime identity and storage. Never put real secrets in this file.
DATABASE_URL=postgresql://alliance_app:replace-me@127.0.0.1:5432/alliance
ALLIANCE_JWT_SECRET=replace-with-at-least-32-random-characters

# The API binds to loopback. Put TLS/authenticated ingress in front of it.
BACKEND_PORT=3001
CORS_ORIGINS=https://alliance.example.com

# Optional typed delivery providers. Each configured endpoint must use HTTPS.
ALLIANCE_CRM_PROVIDER_URL=https://crm.example.com/v1
ALLIANCE_CRM_PROVIDER_TOKEN=replace-me
ALLIANCE_CLM_PROVIDER_URL=https://clm.example.com/v1
ALLIANCE_CLM_PROVIDER_TOKEN=replace-me
ALLIANCE_ERP_PROVIDER_URL=https://erp.example.com/v1
ALLIANCE_ERP_PROVIDER_TOKEN=replace-me
ALLIANCE_NOTIFICATION_PROVIDER_URL=https://notify.example.com/v1
ALLIANCE_NOTIFICATION_PROVIDER_TOKEN=replace-me
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
